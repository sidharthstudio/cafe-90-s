{
  "name": "cafe-90s",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cafe 90's — premium animated restaurant website with online ordering, delivery radius management and admin dashboard.",
  "scripts": {
    "dev": "vite",
    "worker": "wrangler dev --port 8787 --local",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && wrangler dev --port 3000 --ip 0.0.0.0 --local",
    "bundle": "wrangler deploy --dry-run --outdir=dist-worker",
    "db:init": "wrangler d1 execute cafe90s-db --local --file=worker/schema.sql"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "framer-motion": "11.11.17",
    "hono": "4.6.14",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.169.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250620.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "^4.1.11",
    "typescript": "5.6.3",
    "vite": "6.0.5",
    "wrangler": "4.20.5"
  }
}
