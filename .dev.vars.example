# Copy to .dev.vars for local Wrangler development, and set the same names as
# secrets in the hosting dashboard for production. Never commit real values.

# Signs the 7-day admin session cookie. Use a long random string (32+ chars).
SESSION_SECRET=change-me-to-a-long-random-string

# Owner login created automatically the first time the database is seeded.
# If you change these after seeding, the existing account is not overwritten —
# use the dashboard's "Owner password" section (or delete the admin_users row).
ADMIN_EMAIL=admin@cafe90s.in
ADMIN_PASSWORD=Cafe90s@2026
ADMIN_NAME=Owner

# Optional: POST a JSON payload to this URL for every new order (Slack relay, n8n, etc.).
# ORDER_WEBHOOK_URL=

# Optional: only used if a real payment gateway is wired up in worker/index.ts.
# ONLINE_PAYMENT_PROVIDER=
